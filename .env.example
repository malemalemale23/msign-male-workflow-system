# Copy this file to .env and fill in values. .env is gitignored and never committed.

# SQLite file path. This default is fine for local dev/testing —
# it creates an empty database at ./dev.db on first migrate.
DATABASE_URL="file:./dev.db"

# Signs login session cookies. Generate your own random value for a new
# environment (e.g. `openssl rand -base64 32`) — do not reuse the value
# from the production .env. Changing it later logs everyone out.
SESSION_SECRET="replace-with-your-own-generated-secret"
